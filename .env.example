# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=daftra_sync_hub
DB_USER=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=generate_a_long_random_value_for_each_environment
JWT_EXPIRES_IN=7d

# Daftra ERP API
DAFTRA_API_BASE_URL=https://your-account.daftra.com/api2
DAFTRA_API_KEY=your_daftra_api_key_here

# Daftra operational IDs. Verify every ID against your own Daftra account.
DAFTRA_DEFAULT_CLIENT_ID=3
DAFTRA_ZID_CLIENT_ID=3964
CONSOLIDATE_ZID_CLIENTS=true
DAFTRA_ONLINE_STOREHOUSE_ID=3

# Daftra GL accounts
DAFTRA_ZID_REVENUE_ACCOUNT_ID=4689
DAFTRA_GENERAL_REVENUE_ACCOUNT_ID=28
DAFTRA_TRENDYOL_REVENUE_ACCOUNT_ID=4690
DAFTRA_SHIPPING_REVENUE_ACCOUNT_ID=4691
DAFTRA_DISCOUNT_ACCOUNT_ID=365

# Daftra treasuries / settlement accounts
DAFTRA_TABBY_TREASURY_ID=19
DAFTRA_TAMARA_TREASURY_ID=21
DAFTRA_ZIDPAY_TREASURY_ID=18
DAFTRA_COD_TREASURY_ID=35
DAFTRA_TRENDYOL_TREASURY_ID=25

# Daftra tax IDs
DAFTRA_VAT_15_TAX_ID=4
DAFTRA_VAT_15_INCLUSIVE_TAX_ID=7
DAFTRA_VAT_ZERO_TAX_ID=5
DAFTRA_VAT_EXEMPT_TAX_ID=6

# Zid Store API
ZID_API_BASE_URL=https://api.zid.sa/v1
ZID_API_TOKEN=your_zid_token_here
ZID_MANAGER_TOKEN=your_zid_manager_token_here
ZID_STORE_ID=your_zid_store_id

# Webhook signing secrets. Configure the matching SHA-256 HMAC signature header
# (X-Webhook-Signature or X-Signature) at each provider.
ZID_WEBHOOK_SECRET=replace_with_a_long_random_secret
TRENDYOL_WEBHOOK_SECRET=replace_with_a_long_random_secret
DAFTRA_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Trendyol Marketplace API
ENABLE_TRENDYOL=false
TRENDYOL_API_BASE_URL=https://api.trendyol.com/sapigw
TRENDYOL_SUPPLIER_ID=your_trendyol_supplier_id
TRENDYOL_API_KEY=your_trendyol_api_key
TRENDYOL_API_SECRET=your_trendyol_api_secret
